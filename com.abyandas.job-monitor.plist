<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.abyandas.job-monitor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/abyandas/job-monitor/.venv/bin/python</string>
    <string>/Users/abyandas/job-monitor/job_monitor.py</string>
    <string>--loop</string>
