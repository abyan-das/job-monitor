# Discord channel webhook. Treat this URL like a password.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/WEBHOOK_ID/WEBHOOK_TOKEN

# Runtime options
POLL_SECONDS=120
REQUEST_TIMEOUT_SECONDS=25
LOG_LEVEL=INFO
ENABLE_DISCOVERY_SOURCES=false

# Direct Notion integration (read + insert access to Recruiting Tracker)
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=b6d69cf0-e333-4a0a-b223-938050872828
